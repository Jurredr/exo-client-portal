# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase service role - server-side admin only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend - for cron alerts and custom emails
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="EXO Portal <noreply@yourdomain.com>"
# Recipient for overdue invoice cron alerts
OVERDUE_ALERT_EMAIL=exo@jurre.me

# Cron - secures /api/cron/* endpoints (set in Vercel for production)
CRON_SECRET=your_cron_secret

# Optional: override site URL (defaults to Vercel URL in production)
# NEXT_PUBLIC_SITE_URL=https://portal.yourdomain.com
